# Copy to .env and fill in. All are free-tier.
# None are strictly required — the app falls back to cached JSON in data/
# when a key is missing — but real-time behavior needs them.

# EIA — https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# FRED — https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# ACLED — https://developer.acleddata.com/  (academic tier)
ACLED_USERNAME=
ACLED_PASSWORD=

# Server
PORT=8000
